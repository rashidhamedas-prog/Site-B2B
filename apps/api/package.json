{
  "name": "@taranom/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "tsc --noEmit",
    "test": "npx ts-node --transpile-only src/modules/auth/auth.otp.logic.spec.ts && npx ts-node --transpile-only src/modules/blog/blog-seo.util.spec.ts && npx ts-node --transpile-only src/modules/blog/blog-seo-analysis.spec.ts && npx ts-node --transpile-only src/modules/payment/payment-core.hardening.spec.ts && npx ts-node --transpile-only src/modules/payment/payment-hardening.followup.spec.ts && npx ts-node --transpile-only src/modules/payment/payment-concurrency.hardening.spec.ts && npx ts-node --transpile-only src/modules/payment/installment.hardening.spec.ts && npx ts-node --transpile-only src/common/integration-health.spec.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate src/database/migrations/Migration -d src/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-fastify": "^10.0.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.3.0",
    "jose": "^6.2.6",
    "meilisearch": "^0.41.0",
    "minio": "^8.0.7",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.33.5",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^3.0.0",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^16.6.1",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.0"
  }
}
