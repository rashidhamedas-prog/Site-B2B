# ============================================================
# Taranom B2B Platform — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# App
NODE_ENV=production
PORT=4000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=taranom
DB_PASS=CHANGE_ME_STRONG_PASSWORD
DB_NAME=taranom_db
DB_SSL=false

# Redis — shared across API instances (OTP + blog analytics rate-limit / unique-view keys)
# Blog analytics keys: blog:analytics:rl:{ipHash}, blog:analytics:uv:{articleId}:{ipHash}
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=CHANGE_ME_REDIS_PASSWORD

# JWT — required; production refuses to start without a strong secret (min 32 chars)
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES=7d

# Initial admin seed (required in production; optional in development)
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=

# OTP (Redis). When Redis is unreachable in production, OTP request fails closed (no code leak).
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Only in non-production: allow returning OTP in JSON when SMS is not configured
OTP_DEV_EXPOSE_CODE=false

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=CHANGE_ME_MEILI_KEY

# MinIO / S3-compatible storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_USER=taranom_minio
MINIO_PASS=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=taranom-products
# Public URL for browser-accessible images (production: https://poshaktaranom.com/media)
MINIO_PUBLIC_URL=http://localhost:9000/taranom-products

# Set DB_SYNC=true once on fresh server to create tables (then remove)
DB_SYNC=false

# Next.js (public — safe to expose to browser)
NEXT_PUBLIC_API_URL=https://api.poshaktaranom.com
NEXT_PUBLIC_SITE_URL=https://poshaktaranom.com
NEXT_PUBLIC_RETAIL_URL=https://poshaktaranom.ir

# Blog / SEO module
BLOG_DEFAULT_TIMEZONE=Asia/Tehran
BLOG_MAX_UPLOAD_MB=10
BLOG_AUTOSAVE_INTERVAL_SECONDS=30
BLOG_MAX_REVISIONS=50
# Dev only: allow FALLBACK_POSTS when API empty (never in production)
BLOG_ALLOW_FALLBACK=0

# Google Analytics 4 (optional — can also set in Admin → Settings → Google)
# One Measurement ID per storefront; never share across .com / .ir
NEXT_PUBLIC_GA4_WHOLESALE_ID=
NEXT_PUBLIC_GA4_RETAIL_ID=
# Optional Google Tag Manager (official snippet also in app/layout.tsx)
# Defaults in code: wholesale GTM-M3LQFGZV / retail GTM-NKBCGQJV
NEXT_PUBLIC_GTM_WHOLESALE_ID=GTM-M3LQFGZV
NEXT_PUBLIC_GTM_RETAIL_ID=GTM-NKBCGQJV
# Google Search Console HTML-tag verification tokens (content= value only)
NEXT_PUBLIC_GSC_WHOLESALE=
NEXT_PUBLIC_GSC_RETAIL=

# Payment Gateways
ZARINPAL_MERCHANT_ID=CHANGE_ME
ZARINPAL_RETAIL_MERCHANT_ID=CHANGE_ME_RETAIL_MERCHANT
ZARINPAL_SANDBOX=true
PAYMENT_CALLBACK_URL=https://poshaktaranom.com/payment/callback
PAYMENT_RETAIL_CALLBACK_URL=https://www.poshaktaranom.ir/payment/callback
# DigiPay UPG (retail). Prefer admin /settings payment fields; env is fallback.
# Never commit real values. Username/password are the DigiPay panel login.
DIGIPAY_CLIENT_ID=CHANGE_ME
DIGIPAY_CLIENT_SECRET=CHANGE_ME
DIGIPAY_USERNAME=
DIGIPAY_PASSWORD=
DIGIPAY_SANDBOX=false
IDPAY_API_KEY=CHANGE_ME

# SMS (Kavenegar / IPPANEL)
SMS_API_KEY=CHANGE_ME
SMS_SENDER=CHANGE_ME

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHANNEL_ID=@toliditaranom

# CORS
ALLOWED_ORIGINS=https://poshaktaranom.com,https://www.poshaktaranom.com,https://poshaktaranom.ir,https://www.poshaktaranom.ir,https://api.poshaktaranom.com

# CRM inventory API (x-api-key or Authorization: Bearer)
CRM_API_KEY=CHANGE_ME_CRM_API_KEY

# ------------------------------------------------------------
# Non-production identity (required for GET /v1/env-identity + E2E)
# Set ONLY on local / disposable / staging API. Never on production.
# Provision with: bash scripts/provision-e2e-identity.sh [local|disposable|staging]
# Fixture file: scripts/fixtures/e2e-expected-identity.json (or /etc/taranom/...)
# ------------------------------------------------------------
# APP_ENV=disposable
# DEPLOYMENT_IDENTITY=

# ------------------------------------------------------------
# E2E purchase (staging / local / disposable ONLY — never production)
# scripts/e2e-purchase-test.sh requires these at runtime; do not commit real values.
# Host allowlists are immutable in-script — do NOT set E2E_ALLOWED_*.
# SQL activate/password-reset paths were removed; use provisioned users.
# ------------------------------------------------------------
# E2E_TARGET=local
# E2E_ALLOW_MUTATION=1
# E2E_PHONE=
# E2E_PASSWORD=
# E2E_PRODUCT_ID=
# API_URL=http://127.0.0.1:4000/v1
# WEB_URL=http://127.0.0.1:3000
# E2E_IDENTITY_FIXTURE=scripts/fixtures/e2e-expected-identity.json

# Torob Product API v3 — exact audience of the public endpoint (never a domain list)
TOROB_API_AUDIENCE=api.poshaktaranom.com
# TOROB_ORDER_API_AUDIENCE=www.poshaktaranom.ir
# Test/staging only: override JWT public key. Never set a private key.
# TOROB_JWT_PUBLIC_KEY=
